# Copy this file to .env and adjust values for your environment.
# .env is gitignored. To use an external/managed database, change
# POSTGRES_HOST (and optionally PORT, USER, PASSWORD) to point at it.

# Compose project name (controls Docker resource naming)
COMPOSE_PROJECT_NAME=finance-smith

# PostgreSQL connection settings — used by both Compose and the Elixir app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Development database
POSTGRES_DB=finance_smith_dev

# Test database (created automatically by docker/scripts/init-test-db.sh)
POSTGRES_TEST_DB=finance_smith_test

# Ecto connection pool size
POSTGRES_POOL_SIZE=10

# Cloak encryption keys — AES-256-GCM, base64-encoded 32-byte keys.
# Required. No default — the app will not start without them.
# Generate keys with: 32 |> :crypto.strong_rand_bytes() |> Base.encode64()
CLOAK_KEY=<your-dev-key-here>
CLOAK_KEY_TEST=<your-test-key-here>

# Phoenix session signing — required for dev and test (prod uses runtime.exs).
# Generate with: mix phx.gen.secret (needs a .env with keys first), or:
#   elixir -e ':crypto.strong_rand_bytes(64) |> Base.encode64() |> IO.puts()'
SECRET_KEY_BASE=<your-dev-secret-here>
SECRET_KEY_BASE_TEST=<your-test-secret-here>

# Plaid API credentials — get these from https://dashboard.plaid.com/developers/keys
# Use your sandbox client_id and sandbox secret for development and testing.
PLAID_CLIENT_ID=<your-dev-id-here>
SANDBOX_PLAID_SECRET=<your-sandbox-secret-here>

# Production Plaid secret only (required in prod via runtime.exs; not used in dev/test config)
PRODUCTION_PLAID_SECRET=<your-production-secret-here>

# Backblaze B2 — application key scoped to the Plaid bucket (readFiles + writeFiles only)
# Create keys at: https://secure.backblaze.com/app_keys.htm
B2_KEY_ID=
B2_APP_KEY=
B2_KEY_NAME=
B2_BUCKET_NAME=
