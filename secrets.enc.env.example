# Template for the SOPS-encrypted production env file.
#
# Copy to secrets.dec.env, fill in values, then encrypt:
#   sops -e --age "$(grep -oP 'public key: \K.*' age.key)" \
#        secrets.dec.env > secrets.enc.env
#
# secrets.enc.env is committed (it is encrypted).
# secrets.dec.env and age.key are gitignored — never commit them.
#
# See docs/infrastructure.md "Container deployment with SOPS" for the full workflow.

# ---------- Phoenix ----------
SECRET_KEY_BASE=

# Public hostname for generated URLs (no scheme/port). Required in prod to
# match your Cloudflare Tunnel hostname or reverse-proxy FQDN.
# Example: PHX_HOST=finance.example.com
PHX_HOST=

# HTTP port the release listens on (default: 4000)
PORT=4000

# ---------- PostgreSQL ----------
# Full Ecto URL, e.g.: ecto://postgres:secret@127.0.0.1/finance_smith_prod
DATABASE_URL=

# Ecto pool size (default: 10)
POOL_SIZE=10

# ---------- Cloak / AshCloak ----------
# AES-256-GCM key, base64-encoded 32 bytes.
# Generate: 32 |> :crypto.strong_rand_bytes() |> Base.encode64()
CLOAK_KEY=

# ---------- Plaid ----------
PLAID_CLIENT_ID=

# Set to "sandbox" to use sandbox.plaid.com in a prod-mode container
# (e.g. for staging). Omit or set to "production" for live Plaid.
PLAID_ENV=production

# Required when PLAID_ENV=production (or unset):
PRODUCTION_PLAID_SECRET=

# Required when PLAID_ENV=sandbox:
SANDBOX_PLAID_SECRET=

# ---------- Backblaze B2 ----------
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=
